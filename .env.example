# PulseGuard-Z Environment Configuration
# Copy this file to .env and configure for your local environment

# Legacy API Key Authentication
API_KEY=change-me-in-your-local-env
REQUIRE_API_KEY=false

# Dashboard Session Authentication
DASHBOARD_USER=admin
# Format: salt_hex:hash_hex (generate using: python scripts/hash_password.py <password>)
DASHBOARD_PASSWORD_HASH=placeholder_salt_hex:placeholder_hash_hex
SESSION_TTL_MINUTES=30

# CORS Allowed Origins (comma-separated list of allowed web dashboard origins)
# Configure with your actual frontend domain/host in production
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Reverse Proxy Security (comma-separated list of trusted upstream proxy IPs)
# When set, the server safely resolves original client IPs from X-Forwarded-For
# only from these trusted proxy peers, preventing IP rate-limit spoofing.
# Leave empty if running directly without an upstream reverse proxy.
TRUSTED_PROXIES=
